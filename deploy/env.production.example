# Copy to /var/www/groupbuy-tools/.env on the VPS
# Replace all CHANGE_ME values before going live.

# --- App ---
NODE_ENV=production
PORT=3000

# Public URL of the Next.js site (must match Nginx + SSL)
NEXTAUTH_URL=https://app.CHANGE_ME.com
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
# Share login across www + admin subdomains (e.g. .rankmora.io). Optional if NEXTAUTH_URL is set.
# NEXTAUTH_COOKIE_DOMAIN=.rankmora.io

# --- Session security (anti account-sharing) ---
# One active login per user; new login kicks other devices.
# AUTH_SESSION_MAX_AGE_SEC=43200
# AUTH_SESSION_UPDATE_AGE_SEC=60
# Block mid-session IP changes for users (set false if mobile Wi‑Fi/cellular flips too often)
# AUTH_STRICT_IP=true
# AUTH_STRICT_IP_ADMIN=false
# Lock account after N wrong passwords (admin must unblock)
# AUTH_MAX_FAILED_LOGINS=5
# Optional: also email this address on suspicious user logins
# SECURITY_ALERT_EMAIL=rankmoraoffical@gmail.com

# --- Database (Supabase or Postgres on same VPS) ---
# Supabase on a VPS: use the session pooler (IPv4), not db.*.supabase.co (IPv6).
# Example (ap-northeast-1): postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# Add connection_limit=1 when using Supabase pooler in session mode:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?connection_limit=1

# Do NOT use mock mode in production
# USE_MOCK_DATA=false

# --- Session service (internal) ---
# Next.js calls this on localhost — session-service binds to 127.0.0.1 only
SESSION_SERVICE_URL=http://127.0.0.1:4000
SESSION_SERVICE_PORT=4000

# Public URL users hit for /go/ and /proxy/ (session apex; tool hosts override when set)
# IP-only VPS example: http://74.208.248.8/session  (requires deploy/nginx/ip-only.conf)
SESSION_SERVICE_PUBLIC_URL=https://session.CHANGE_ME.com

# Per-tool hosts: https://semrush.tools.CHANGE_ME.com
# DNS: wildcard A record *.tools.CHANGE_ME.com -> VPS
SESSION_TOOLS_BASE_DOMAIN=tools.CHANGE_ME.com
# Cookie Domain for shared tool hosts (leading dot). Leave unset if using path proxy only.
# SESSION_COOKIE_DOMAIN=.tools.CHANGE_ME.com

# Shared secret between Next.js and session-service
SESSION_SERVICE_API_KEY=CHANGE_ME_long_random_string

# Encrypts tool account cookies at rest (same value on web + session service)
SESSION_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32

# --- Admin subdomain (optional) ---
# When set, /admin on the main site redirects here; admin login is separate from /login
# ADMIN_HOST=admin.CHANGE_ME.com
# NEXT_PUBLIC_ADMIN_URL=https://admin.CHANGE_ME.com
# NEXT_PUBLIC_APP_URL=https://app.CHANGE_ME.com

# --- Stripe ---
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook URL: https://app.CHANGE_ME.com/api/stripe/webhook

# --- Email / forgot password (SMTP) ---
# IONOS blocks outbound port 25 — use 587 (STARTTLS) or 465 (SSL).
# Recommended: Resend (https://resend.com) or Namecheap Private Email.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=re_CHANGE_ME
# EMAIL_FROM=noreply@rankmora.io
# EMAIL_FROM_NAME=GroupBuy Tools
