# Rankmora on Railway = TWO services (same GitHub repo)
#
# 1) TOOLS  — Next.js website (you already have this)
# 2) SESSION — cookie/session proxy (required for tool Launch)
#
# DNS:
#   rankmora.io         → TOOLS service
#   session.rankmora.io → SESSION service
#
# Copy secrets from your existing TOOLS variables / VPS .env.

# ---------- Shared (set on BOTH services) ----------
NODE_ENV=production
DATABASE_URL=${{Postgres-CSxL.DATABASE_URL}}
SESSION_ENCRYPTION_KEY=CHANGE_ME
SESSION_SERVICE_API_KEY=CHANGE_ME

# ---------- TOOLS service only (Raw Editor) ----------
# NEXTAUTH_URL=https://rankmora.io
# NEXT_PUBLIC_APP_URL=https://rankmora.io
# NEXTAUTH_SECRET=CHANGE_ME
# SESSION_SERVICE_URL=https://session.rankmora.io
# SESSION_SERVICE_PUBLIC_URL=https://session.rankmora.io
# USE_MOCK_DATA=false
# + SMTP / Stripe / EMAIL_* as needed

# ---------- SESSION service only (Raw Editor) ----------
SESSION_SERVICE_PUBLIC_URL=https://session.rankmora.io
SESSION_SERVICE_BIND_HOST=0.0.0.0
# Railway sets PORT automatically — do not force 4000
